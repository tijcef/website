DirectoryIndex index.html
Options -Indexes

RewriteEngine On

RewriteCond %{HTTP_HOST} ^tijcef\.org$ [NC]
RewriteRule ^ https://www.tijcef.org%{REQUEST_URI} [R=301,L,NE]

# THE_REQUEST prevents these redirects firing for internal index.html rewrites.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.+?)/+(?:[?\s])
RewriteRule ^(.+?)/+$ /$1 [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.tijcef.org%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

RewriteRule ^post/[^/]+/?$ post-shell.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  <FilesMatch "^(404\.html)$">
    Header always set X-Robots-Tag "noindex, follow"
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
